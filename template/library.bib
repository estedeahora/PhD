title = {{Nuevos roles de los gobiernos locales en la implementaci{\'{o}}n de pol{\'{i}}ticas p{\'{u}}blicas: Gobernabilidad territorial y competitividad global}},
url = {http://www.scielo.cl/scielo.php?script=sci_arttext&pid=S0250-71612015000300009&lng=en&nrm=iso&tlng=en},
