keywords = {DE: School choice,France,Francia,Sociologie,acquisition des donn{\'{e}}es,clase media,elecci{\'{o}}n de la escuela,espace,investigaci{\'{o}}n cualitativa,middle-class,perspective,proc{\`{e}}s,qualitative research,reflexividad,reflexivity,responsabilit{\'{e}},rondelle,scool choice,{\'{e}}cole,{\'{e}}lection},
mendeley-tags = {DE: School choice},
