isbn = {0304-3975},
issn = {03043975},
journal = {Theoretical Computer Science},
keywords = {Algorithm,Combinatorics,Dynamic programming,SA: Medidas,Subsequence,_Impreso},
mendeley-tags = {SA: Medidas,_Impreso},
number = {3},
pages = {394--404},
publisher = {Elsevier B.V.},
title = {{Algorithms for subsequence combinatorics}},
url = {http://dx.doi.org/10.1016/j.tcs.2008.08.035},
