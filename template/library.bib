isbn = {9789876302692},
keywords = {1. Movilidad. 2. Utilizaci{\'{o}}n del Espacio. 3. {\'{A}}reas,US: Capital espacial,US: Movilidad cotidiana,US: Movilidad residencial},
mendeley-tags = {US: Capital espacial,US: Movilidad cotidiana,US: Movilidad residencial},
pages = {226},
