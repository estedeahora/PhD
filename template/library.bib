issn = {01697439},
journal = {Chemometrics and Intelligent Laboratory Systems},
keywords = {Generalised canonical analysis,Hierarchical factor analysis,ML_FA: MFA,Multiple factor analysis,PLS path modelling,PLS regression,Structural equation modelling},
mendeley-tags = {ML_FA: MFA},
number = {2},
