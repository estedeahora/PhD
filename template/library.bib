@article{Becue-Bertaut2008,
abstract = {Analysing and clustering units described by a mixture of sets of quantitative, categorical and frequency variables is a relevant challenge. Multiple factor analysis is extended to include these three types of variables in order to balance the influence of the different sets when a global distance between units is computed. Suitable coding is adopted to keep as close as possible to the approach offered by principal axes methods, that is, principal component analysis for quantitative sets, multiple correspondence analysis for categorical sets and correspondence analysis for frequency sets. In addition, the presence of frequency sets poses the problem of selecting the unit weighting, since this is fixed by the user (usually uniform) in principal component analysis and multiple correspondence analysis, but imposed by the table margin in correspondence analysis. The method's main steps are presented and illustrated by an example extracted from a survey that aimed to cluster respondents to a questionnaire that included both closed and open-ended questions. {\textcopyright} 2007 Elsevier B.V. All rights reserved.},
author = {B{\'{e}}cue-Bertaut, M{\'{o}}nica and Pag{\`{e}}s, J{\'{e}}r{\^{o}}me},
doi = {10.1016/j.csda.2007.09.023},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/B{\'{e}}cue-Bertaut, Pag{\`{e}}s - 2008 - Multiple Factor Analysis and Clustering of a mixture of quantitative, categorical and frequency data.pdf:pdf},
issn = {01679473},
journal = {Computational Statistics and Data Analysis},
keywords = {Clustering,Distance,ML_CL: Cluster,ML_FA: Clustering dimensions,ML_FA: MFA,Mixed data,Multiple factor analysis,Multiple factor analysis for contingency tables,Survey,Textual data},
mendeley-tags = {ML_CL: Cluster,ML_FA: Clustering dimensions,ML_FA: MFA},
number = {6},
pages = {3255--3268},
title = {{Multiple Factor Analysis and Clustering of a mixture of quantitative, categorical and frequency data}},
volume = {52},
year = {2008}
}
