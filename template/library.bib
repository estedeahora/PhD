arxivId = {1514-6871},
author = {Martinez, Ana Teresa},
doi = {1514-6871},
eprint = {1514-6871},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Martinez - 2008 - Una indagaci{\'{o}}n sociol{\'{o}}gica sobre el campo literario. Las Reglas del arte, seg{\'{u}}n Pierre Bourdieu.pdf:pdf},
isbn = {9788433913975},
issn = {1514-6871},
journal = {Trabajo y sociedad},
number = {10},
