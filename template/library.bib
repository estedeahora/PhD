title = {{Movilidad residencial de sectores medios y populares: la ciudad de Buenos Aires como punto de llegada}},
url = {http://www.scielo.br/pdf/cm/v20n41/2236-9996-cm-20-41-0099.pdf},
volume = {20},
year = {2018}
