journal = {VertigO - la revue {\'{e}}lectronique en sciences de l'environnement [En ligne]},
keywords = {US: Capital espacial,capital environnemental,environnement,injustice environnementale,in{\'{e}}galit{\'{e}}s sociales,recompositions socio-spatiales},
mendeley-tags = {US: Capital espacial},
