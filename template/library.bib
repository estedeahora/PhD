journal = {Urban Studies},
keywords = {DE: Geography of education,DE: School choice,DE: Segmentaci{\'{o}}n educativa,DE: Segregaci{\'{o}}n educativa,US: Segregaci{\'{o}}n urbana,demographics,education,inequality,neighbourhood change,neighbourhoods and schools,race/ethnicity},
mendeley-tags = {DE: Geography of education,DE: School choice,DE: Segmentaci{\'{o}}n educativa,DE: Segregaci{\'{o}}n educativa,US: Segregaci{\'{o}}n urbana},
