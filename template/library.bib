@article{Reay1997,
abstract = {Drawing on data from an Economic and Social Research Council (ESRC) funded study of market forces in secondary education, this paper explores the ambivalence displayed by many working-class parents in the research to the idea of choice of school. School is frequently associated with powerful memories and images of personal failure. The authors argue: that for working-class parents choice can sometimes involve complex and powerful accommodations to the idea of 'school' and is very different in kind from middle-class choice making; that social class remains a potent differentiating category in the analysis of home-school relations; and that choice is a new social device through which social class differences are rendered into educational inequality. Extracts from interview data are quoted to support and illustrate these arguments.},
author = {Reay, Diane and Ball, Stephen John},
doi = {10.1080/0305498970230108},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Reay, Ball - 1997 - 'Spoilt for Choice' the working classes and educational markets.pdf:pdf},
issn = {03054985},
journal = {Oxford Review of Education},
keywords = {DE: School choice},
mendeley-tags = {DE: School choice},
number = {1},
pages = {89--101},
title = {{'Spoilt for Choice': the working classes and educational markets}},
volume = {23},
year = {1997}
}
@article{Blanco2011,
abstract = {El objetivo principal de este art{\'{i}}culo es revisar el surgimiento y desarrollo de la orientaci{\'{o}}n te{\'{o}}rico-metodol{\'{o}}gica conocida como curso de vida, enfoque que investiga fundamentalmente c{\'{o}}mo los eventos hist{\'{o}}ricos y los cambios econ{\'{o}}micos, demogr{\'{a}}ficos, sociales y culturales, configuran las vidas individuales y los agregados poblacionales –cohortes o generaciones–. Se exponen sus principios rectores y sus conceptos centrales y, en el apartado final, los principales temas abordados desde la d{\'{e}}cada de 1980. Se llev{\'{o}} a cabo un examen, no exhaustivo pero s{\'{i}} representativo, de la bibliograf{\'{i}}a en la literatura anglosajona; adem{\'{a}}s, se incluye una variedad de referencias de habla hispana, b{\'{a}}sicamente de la d{\'{e}}cada de los noventa y de la primera del milenio. De este modo, cumplimos con el otro objetivo de este trabajo: brindar al lector una amplia bibliograf{\'{i}}a de consulta que abarque los postulados te{\'{o}}ricos y metodol{\'{o}}gicos clave y una diversidad de tem{\'{a}}ticas espec{\'{i}}ficas que estudian los diferentes dominios y trayectorias vitales.},
