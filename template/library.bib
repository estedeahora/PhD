issn = {2422-6483},
journal = {Estudios del h{\'{a}}bitat},
keywords = {Cartografi a,Cesar Vap{\~{n}}arsky,Horacio Torres,Patricio Randle,US: Crecimiento AMGBA,US: Historia AMGBA,{\'{A}}rea metropolitana},
mendeley-tags = {US: Crecimiento AMGBA,US: Historia AMGBA},
