@article{Sattin-Bajaj2018,
abstract = {Multiple studies have shown the potential for school choice policies to benefit middle-class families, often to the detriment of lower income students in the same district. Yet, there is limited research examining the role of policies in promoting inequality by encouraging exclusionary behaviors. In this article, we utilize the concept of opportunity hoarding to analyze the specific policy provisions built into New York City's elementary and high school choice plans that prompt middle-class parents to act in ways that secure advantages for their children. We find that parents' anxiety about scarcity of high-quality educational options combined with the design of the choice policies facilitated pervasive opportunity hoarding that functioned as a collective strategy of class preservation.},
author = {Sattin-Bajaj, Carolyn and Roda, Allison},
doi = {10.1177/0895904818802106},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Sattin-Bajaj, Roda - 2018 - Opportunity Hoarding in School Choice Contexts The Role of Policy Design in Promoting Middle-Class Parents'.pdf:pdf},
isbn = {0895904818802},
issn = {08959048},
journal = {Educational Policy},
keywords = {DE: School choice,educational equity,educational policy,middle-class parents,parent involvement,school choice,social reproduction,urban schools},
mendeley-tags = {DE: School choice},
pages = {1--44},
title = {{Opportunity Hoarding in School Choice Contexts: The Role of Policy Design in Promoting Middle-Class Parents' Exclusionary Behaviors}},
year = {2018}
}
