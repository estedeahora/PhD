@inproceedings{Videgain2014,
abstract = {Nos proponemos analizar los procesos de cambio en las trayectorias tempranas del curso de vida de mujeres y varones en contextos de cambios socio-hist{\'{o}}ricos mexicanos. A trav{\'{e}}s de un an{\'{a}}lisis de secuencia construimos tipolog{\'{i}}as de trayectorias individuales de estados que responden a tres dominios de vida: escuela, familia y trabajo; asociados a cohortes hist{\'{o}}ricas y estructuras de desigualdad: sexo y estrato de origen. Para ello utilizamos datos de la Encuesta Demogr{\'{a}}fica Retrospectiva del 2011 que nos permiti{\'{o}} reconstruir las trayectorias laborales, educativas y de formaci{\'{o}}n familiar de tres cohortes de nacimiento (1951, 1966 y 1978) de mujeres y varones residentes en centros urbanos mexicanos. Bajo la hip{\'{o}}tesis de desestandarizaci{\'{o}}n nos interes{\'{o}} indagar en otras fuentes de regulaci{\'{o}}n de los curos de vida: sexo y estrato de origen. Ante la emergencia de nuevas trayectorias a la vida adulta ¿estamos ante un escenario de impredecibilidad de los cursos de vida? Consideramos que la desestandarizaci{\'{o}}n no s{\'{o}}lo debe ser constatada, sino descrita en tanto procesos que la componen. Las trayectorias individuales responden a calendarios y desigual participaci{\'{o}}n en espacios de vida por sexo y estrato. Los trayectos a la vida adulta pueden ser tambi{\'{e}}n procesos de fijaci{\'{o}}n de desigualdades sociales.},
address = {Per{\'{u}}},
author = {Videgain, Karina},
