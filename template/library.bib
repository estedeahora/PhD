@article{DuruBellat2004,
abstract = {Actualmente, entre los temas presentes en la agencia pol{\'{i}}tica de casi todos los pa{\'{i}}ses -excepto Francia, donde sigue siendo tema tab{\'{u}}- se encuentra la de que las familias dispongan de capacidad de elecci{\'{o}}n del centro escolar en que estudien sus hijos. Los pol{\'{i}}ticos franceses dudan lanzar el debate sobre dicho tema ante el temor de que una apertura de posibilidades aumente la segregaci{\'{o}}n escolar y comprometa la unidad de un sistema educativo que debe ofrecer igualdad de oportunidades para todos. Para aclarar dicha cuesti{\'{o}}n, basta comparar las investigaciones que eval{\'{u}}en las experiencias extranjeras en materia de elecci{\'{o}}n de centro escolar por los padres. A este respecto, hay una gran variedad y, tanto como en el extranjero, las comparaciones (internacionales) pueden servir de base para la experimentaci{\'{o}}n. Primeramente, situaremos las experiencias en su contexto ideol{\'{o}}gico y te{\'{o}}rico; a continuaci{\'{o}}n se ofrecer{\'{a}} una descripci{\'{o}}n y an{\'{a}}lisis de las investigaciones evaluadoras c{\'{i}}e sus efectos, en particular sobre la eficacia y equidad de los sistemas educativos, para profundizar finalmente en la especificidad francesa.},
author = {{Duru Bellat}, Mairet},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Duru Bellat - 2004 - Debates y pr{\'{a}}cticas en materia de elecci{\'{o}}n de centros escolares en los pa{\'{i}}ses europeos y los Estados Unidos.pdf:pdf},
