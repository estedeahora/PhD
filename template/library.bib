file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Menazzi - 2012 - El proceso en la ciudad. El caso del traslado del Mercado Nacional de Hacienda de Liniers durante la {\'{u}}ltima dictadura m.pdf:pdf},
