file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Ferraris, Mart{\'{i}}nez Salgado - 2015 - Entre la escuela y el trabajo. El tr{\'{a}}nsito a la vida adulta de los j{\'{o}}venes en la Ciudad de Buenos Ai.pdf:pdf},
issn = {01867210},
journal = {Estudios Demogr{\'{a}}ficos y Urbanos},
keywords = {EHA,curso de vida,inicio de la vida labora,j{\'{o}}venes,salida de la escuela,transiciones a la vida adulta},
mendeley-tags = {EHA},
number = {2},
pages = {405--431},
title = {{Entre la escuela y el trabajo. El tr{\'{a}}nsito a la vida adulta de los j{\'{o}}venes en la Ciudad de Buenos Aires y el Distrito Federal}},
