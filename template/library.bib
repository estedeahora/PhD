doi = {http://dx.doi.org/10.7440/res44.2012.15},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Di Virgilio, Gil y de Anso - 2012 - Estrategias habitacionales de familias de sectores populares y medios residentes en el {\'{a}}rea metropol.pdf:pdf},
