journal = {Urban Geography},
keywords = {Social Class,US: Multi-dimension Segregation,US: Segregaci{\'{o}}n urbana,cultural Capital,segregation,spatial Sorting},
mendeley-tags = {US: Multi-dimension Segregation,US: Segregaci{\'{o}}n urbana},
number = {4},
pages = {481--506},
publisher = {Routledge},
title = {{Multiple dimensions of residential segregation. The case of the metropolitan area of Amsterdam}},
