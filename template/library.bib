@article{Aisenbrey2010,
abstract = {In this article the authors draw attention to the most recent and promising developments of sequence analysis. Taking methodological developments in life course sociology as the starting point, the authors detail the complementary strength in sequence analysis in this field. They argue that recent advantages of sequence analysis were developed in response to criticism of the original work, particularly optimal matching analysis. This debate arose over the past two decades and culminated in the 2000 exchange in Sociological Methods & Research. The debate triggered a "second wave" of sequence techniques that led to new technical implementations of old ideas in sequence analysis. The authors bring these new technical approaches together, demonstrate selected advances with synthetic example data, and show how they conceptually contribute to life course research. This article demonstrates that in less than a decade, the field has made much progress toward fulfilling the prediction that Andrew Abbott made in 2000, that "anybody who believes that pattern search techniques are not going to be basic to social sciences over the next 25 years is going to be very much surprised" (p. 75). {\textcopyright} The Author(s) 2010.},
annote = {From Duplicate 1 (New life for old ideas: The "second wave" of sequence analysis bringing the "course" back into the life course - Aisenbrey, Silke; Fasang, Anette Eva)

Las autores proponen un recorrido sobre el surgimiento de la t{\'{e}}cnica de SA.

En primer lugar, destacan el surgimiento del SA en el marco del paradigma del Life Course (LC), con origen en los a{\~{n}}os 70. Este paradigma tiene como t{\'{o}}pico central incluir el impacto de los (a) contextos hist{\'{o}}ricos y (b) las estructuras institucionales en los cursos de vida individuales, as{\'{i}} como de (c) la interdependencia entre diferentes esferas de la vida, todos los cuales generan diferentes patrones para los cursos de vida. 

Este paradigma propone dos conceptos centrales: transici{\'{o}}n (enfocado en los cambios discretos) y trayectorias (de car{\'{a}}cter hol{\'{i}}stico). A su vez, este paradigma ha constituido una tr{\'{i}}ada metodol{\'{o}}gica-te{\'{o}}rica: (a) datos longitudinales; (b) LC; y (c) EHA.

Como respuesta a las limitaciones de los m{\'{e}}todos de EHA en relaci{\'{o}}n al LC surge SA a mediados de los a{\~{n}}os 80. SA surge como una herramienta que (1) permite abordar el desequilibrio entre transici{\'{o}}n y trayectoria (EHA s{\'{o}}lo concentra en el primero) y (2) el problema de la "individualizaci{\'{o}}n" / "pluralizaci{\'{o}}n" [PS: No comprendo]. SA propone (a diferencia de EHA), pensar los eventos en contexto.

Seg{\'{u}}n el autor existen dos "olas" dentro de la historia de SA. 

1) La "primera ola de SA": Surgimiento y vinculaci{\'{o}}n entre SA y OM (423-428)
Responde al momento de aplicaci{\'{o}}n de SA en los a{\~{n}}os 80-90 y se centra en el uso de OM. Esta aplicaci{\'{o}}n recibi{\'{o}} una "ola de cr{\'{i}}ticas".



2) La "segunda ola de SA": Desarrollo de nuevos m{\'{e}}todos
La 2da ola de SA se centra en nuevas implementaciones y nuevas t{\'{e}}cnicas basadas en las ideas de la 1era ola. Entre las propuestas se (a) refinan las t{\'{e}}cnicas; (b) se proponen nuevos m{\'{e}}todos espec{\'{i}}ficos a pregntas espec{\'{i}}ficas (aplicaciones; y (c) se responden a las cr{\'{i}}ticas hechas.
},
author = {Aisenbrey, Silke and Fasang, Anette Eva},
doi = {10.1177/0049124109357532},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Aisenbrey, Fasang - 2010 - New life for old ideas The second wave of sequence analysis bringing the course back into the life course.pdf:pdf},
isbn = {0049124110},
issn = {00491241},
journal = {Sociological Methods & Research},
keywords = {Life course,Longitudinal data analysis,Optimal matching analysis,SA,SA: Situaci{\'{o}}n,Sequence analysis,_Impreso},
mendeley-tags = {SA,SA: Situaci{\'{o}}n,_Impreso},
number = {3},
pages = {420--462},
title = {{New life for old ideas: The "second wave" of sequence analysis bringing the "course" back into the life course}},
volume = {38},
year = {2010}
}
