issn = {23318422},
journal = {arXiv},
keywords = {EHA: Survival Analysis,Fine-gray model,Inverse-censoring probability,Large-scale data,Scalable computing,Semi-parametric modeling,Survival analysis,Time-to-event data},
mendeley-tags = {EHA: Survival Analysis},
pages = {1--18},
title = {{A fast and scalable implementation method for competing risks data with the R package fastcmprsk}},
volume = {XX},
year = {2019}
}
