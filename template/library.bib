@article{DiazOrueta2003a,
abstract = {El an{\'{a}}lisis de la exclusi{\'{o}}n social en las ciudades se dirige, con frecuencia, hacia {\'{a}}reas muy delimitadas donde se concentran las situaciones m{\'{a}}s extremas de malestar urbano. De hecho, cuando se dan, es en esas zonas donde confluyen los principales planes y programas de intervenci{\'{o}}n implementados desde la Administraci{\'{o}}n. Sin embargo, la exclusi{\'{o}}n no presenta siempre una expresi{\'{o}}n territorial tan clara. As{\'{i}}, la agudizaci{\'{o}}n de los procesos de fragmentaci{\'{o}}n social no se traduce, necesariamente, en la formaci{\'{o}}n de espacios fuertemente segregados. En el art{\'{i}}culo se analiza la evoluci{\'{o}}n reciente de la ciudad de Buenos Aires y, m{\'{a}}s concretamen- te, de dos barrios de la zona sur: San Telmo y La Boca. En ambos casos existen diversos proyectos de recua- lificaci{\'{o}}n urbana, ligados al desarrollo de la econom{\'{i}}a cultural. Sin embargo, las experiencias estudiadas, a pe- sar de producirse de manera simult{\'{a}}nea y en un contexto de crisis estructural de la econom{\'{i}}a argentina, presentan particularidades muy importantes. Se trata de dos formaciones socioespaciales diferentes, con dis- tintos grados de articulaci{\'{o}}n social y, por lo tanto, construyendo respuestas sociales espec{\'{i}}ficas a los proce- sos de reestructuraci{\'{o}}n urbana. Palabras},
author = {{D{\'{i}}az Orueta}, Fernando and {Lour{\'{e}}s Seoane}, Mar{\'{i}}a Luisa and Rodr{\'{i}}guez, Mar{\'{i}}a Carla and Devalle, Ver{\'{o}}nica},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/D{\'{i}}az Orueta et al. - 2003 - Ciudad, territorio y exclusi{\'{o}}n social. Las pol{\'{i}}ticas de recualificaci{\'{o}}n urbana en la ciudad de Buenos Aires.pdf:pdf},
journal = {REIS - Revista espa{\~{n}}ola de investigaciones sociol{\'{o}}gicas},
keywords = {Argentina,Ciudades,Exclusi{\'{o}}n Social,Pol{\'{i}}tica Local},
pages = {159--185},
title = {{Ciudad, territorio y exclusi{\'{o}}n social. Las pol{\'{i}}ticas de recualificaci{\'{o}}n urbana en la ciudad de Buenos Aires.}},
volume = {103},
year = {2003}
}
@inproceedings{Steel2010,
abstract = {Neoliberal politics make Latin American cities ever more attractive for investors from abroad. The arrival of foreign companies or foreign currencies results in struggles about the control and ownership of space. In Cusco, for example, local - and especially poor - residents are in permanent struggle to have access to the historic center for economic means. In the hope to open up spaces for touristic development, the local authorities of Cusco try to remove these people from the highly globalized city center to the outskirts of the city. In Cuenca, Ecuador, gentrification occurs in the area of El Ejido, close to the colonial center. There, the construction of appartment buildings for a new middle class affects local real estate markets as well as the urban image. Local elites try to counter gentrification by monumentalizing the area. Nevertheless, for many lower-class citizens the area becomes increasingly inaccessible. This paper discusses the impact of international investment and displacement policies on local development potentials in both Andean cities.},
address = {Toronto},
author = {Steel, Griet and Klaufus, Christien},
booktitle = {Congress of the Latin American Studies Association},
title = {{Displacement by/for development in two Andean cities}},
year = {2010}
}
