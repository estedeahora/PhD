@article{SalazarMiranda2022,
abstract = {One billion people live in informal settlements worldwide. The complex and multilayered spaces that characterize this unplanned form of urbanization pose a challenge to traditional approaches to mapping and morphological analysis. This study proposes a methodology to study the morphological properties of informal settlements based on terrestrial LiDAR (Light Detection and Ranging) data collected in Rocinha, the largest favela in Rio de Janeiro, Brazil. To measure the morphology of the informal settlement, we propose a series of five metrics related to the geometric characteristics of streets: street width, street elevation, facade heterogeneity, facade density, and street canyon. Our analysis operates at two resolutions, including a global analysis focused on comparing different favela streets to one another and a local analysis unpacking the variation of morphological metrics within streets. We show that our methodology reveals meaningful differences and commonalities in terms of the global morphological characteristics across streets and their local variations, which align with the historical evidence of the favela's development. Finally, we create morphological maps at high spatial resolution from LiDAR data to inform urban planning assessments of concerns related to crowding, structural safety, air quality, and accessibility in the favela. The methods for this study are automated and can be easily scaled to analyze entire informal settlements, leveraging the increasing availability of inexpensive LiDAR scanners on portable devices such as cellphones.},
author = {{Salazar Miranda}, Arianna and Du, Guangyu and Gorman, Claire and Duarte, Fabio and Fajardo, Washington and Ratti, Carlo},
doi = {10.1177/23998083221080174},
issn = {2399-8083},
journal = {Environment and Planning B: Urban Analytics and City Science},
keywords = {AE: Machine Learning,AE: Urban structure analysis,LiDAR,_Online first,_sin-pdf,asentamientos informales,escaneo l{\'{a}}ser,morfolog{\'{i}}a,urbanismo},
mendeley-tags = {AE: Machine Learning,AE: Urban structure analysis,_Online first,_sin-pdf},
month = {apr},
pages = {239980832210801},
title = {{Favelas 4D: Scalable methods for morphology analysis of informal settlements using terrestrial laser scanning data}},
url = {http://journals.sagepub.com/doi/10.1177/23998083221080174},
year = {2022}
}
@article{Solis2019,
abstract = {We analyze the role of schooling on intergenerational class mobility in Argentina, Chile, and Mexico. In order to understand the role of schooling it is important to identify its effects as mediator, equalizer and attenuator. We specify, both conceptually and methodologically, these effects and generate empirical indicators for them, using data from national mobility surveys. Our findings indicate that schooling is a powerful mediator in the three countries. However, there are variations between countries in the role of schooling as equalizer and there is no evidence of a significant role as attenuator of the association between class origins and destinations. This suggests that any simplistic interpretation of the effects of schooling on class mobility in Latin America is confronted by a more complex reality, in which schooling is surely an important intervening variable, but has a limited contribution in neutralizing the effects of class origins on class destinations.},
author = {Sol{\'{i}}s, Patricio and Dalle, Pablo},
doi = {10.3989/ris.2019.77.1.17.102},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Sol{\'{i}}s, Dalle - 2019 - La pesada mochila del origen de clase. Escolaridad y movilidad intergeneracional de clase en Argentina, Chile y M{\'{e}}.pdf:pdf},
issn = {1988429X},
journal = {Revista Internacional de Sociologia},
keywords = {DE: Desigualdad educativa,DE: Movilidad social educativa,Inequality of opportunity,Intergenerational social mobility,Latin America,Schooling},
mendeley-tags = {DE: Desigualdad educativa,DE: Movilidad social educativa},
number = {1},
pages = {1--17},
title = {{La pesada mochila del origen de clase. Escolaridad y movilidad intergeneracional de clase en Argentina, Chile y M{\'{e}}xico}},
volume = {77},
year = {2019}
}
@techreport{Maier2014,
abstract = {Dirichlet regression models can be used to analyze a set of variables lying in a bounded interval that sum up to a constant (e.g., proportions, rates, compositions, etc.) exhibiting skewness and heteroscedasticity, without having to transform the data. There are two parametrization for the presented model, one using the common Dirichlet distribution's alpha parameters, and a reparametrization of the alpha's to set up a mean-and-dispersion-like model. By applying appropriate link-functions, a GLM-like framework is set up that allows for the analysis of such data in a straightforward and familiar way, because interpretation is similar to multinomial logistic regression. This paper gives a brief theoretical foundation and describes the implementation as well as application (including worked examples) of Dirichlet regression methods implemented in the package DirichletReg (Maier, 2013) in the R language (R Core Team, 2013). (author's abstract)},
author = {Maier, Marco J.},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Maier - 2014 - DirichletReg Dirichlet Regression for compositional data in R.pdf:pdf},
institution = {Wirtschafts Universit{\"{a}}t Wien},
keywords = {ML_LR: Dirichlet Regression,ML_LR: GLM,R,compositional data,dirichlet distribution,dirichlet regression,model,multivariate generalized linear,proportions,r,rates,simplex},
mendeley-tags = {ML_LR: Dirichlet Regression,ML_LR: GLM,R},
number = {125},
title = {{DirichletReg: Dirichlet Regression for compositional data in R}},
url = {http://dirichletreg.r-forge.r-project.org/},
year = {2014}
}
@article{Dignum2022,
abstract = {Excess school segregation is a phenomena observed across many countries and one common explanation from the literature is the hypothesis that parents might want to live in a diverse neighbourhood, but when it comes to their children, they are less tolerant with respect to school compositions. This study uses an agent-based model where households face residential decisions depending on neighbourhood compositions and make school choices based on distance and school compositions. Results indicate that increased school segregation relative to residential segregation can be observed in large parts of the parameter space, even when the tolerance for households belonging to the other group is equal for neighbourhood and school compositions. Our results demonstrate that asymmetric preferences are not a requirement for excess school segregation and show that residential segregation combined with distance preferences play a key role in this increase.},
author = {Dignum, Eric and Athieniti, Efi and Boterman, Willem Rogier and Flache, Andreas and Lees, Michael},
doi = {10.1016/j.compenvurbsys.2022.101772},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Dignum et al. - 2022 - Mechanisms for increased school segregation relative to residential segregation a model-based analysis.pdf:pdf},
issn = {01989715},
journal = {Computers, Environment and Urban Systems},
keywords = {AE: Medida de segregaci{\'{o}}n,Agent-based modellingSchool choiceSchool segregati,DE: Segregaci{\'{o}}n educativa,US: Multi-domain Segregation,US: Segregaci{\'{o}}n urbana,_Online first},
mendeley-tags = {AE: Medida de segregaci{\'{o}}n,DE: Segregaci{\'{o}}n educativa,US: Multi-domain Segregation,US: Segregaci{\'{o}}n urbana,_Online first},
number = {January},
pages = {101772},
publisher = {Elsevier Ltd},
title = {{Mechanisms for increased school segregation relative to residential segregation: a model-based analysis}},
