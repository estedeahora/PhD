@article{Novick2016,
abstract = {A lo largo del siglo XX e inicios del siglo XXI, el Gran Buenos Aires fue objeto de variadas representaciones gr{\'{a}}ficas, desde detallados mapas topogr{\'{a}}ficos hasta esquemas propositivos. ¿Qu{\'{e}} relaciones se establecieron entre los mapas y los esquemas de los planes urban{\'{i}}sticos formulados para la regi{\'{o}}n metropolitana de Buenos Aires durante ese per{\'{i}}odo? Seg{\'{u}}n planteamos, las tensiones que se dirimen entre la “ciudad existente” –tal como se presenta en las bases cartogr{\'{a}}ficas– y la “ciudad proyectada” –que resulta de los esquemas interpretativos y propositivos–, muestran que las im{\'{a}}genes, signadas por tecnolog{\'{i}}as, debates y m{\'{e}}todos en transformaci{\'{o}}n, construyen diferentes formas de mirar. Para tratar esa problem{\'{a}}tica, sin pretender una historia de larga duraci{\'{o}}n ni un compendio, este art{\'{i}}culo propone un recorrido exploratorio por cuatro puntos de inflexi{\'{o}}n que consideramos ilustrativos del proceso de construcci{\'{o}}n de la imagen del Gran Buenos Aires.},
author = {Novick, Alicia and Favelukes, Graciela and Vecslir, Lorena},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Novick, Favelukes, Vecslir - 2016 - Mapas, planes y esquemas en la construcci{\'{o}}n del Gran Buenos Aires.pdf:pdf},
issn = {0328-9796},
journal = {Anales del IAA},
keywords = {Cartograf{\'{i}}a metropolitana,Gran Buenos Aires,Historia urbana,Planificaci{\'{o}}n urbana,Representaciones gr{\'{a}}ficas,US: Crecimiento AMGBA,US: Historia AMGBA},
mendeley-tags = {US: Crecimiento AMGBA,US: Historia AMGBA},
number = {45},
