isbn = {9789877230659},
journal = {Revista foro de educaci{\'{o}}n musical, artes y pedagog{\'{i}}a},
keywords = {acto escolar,campo escolar,desigualdad escolar,ense{\~{n}}anza musical,habitus del docente de m{\'{u}}sica,sociolog{\'{i}}a de la educaci{\'{o}}n musical},
number = {1},
pages = {33--52},
title = {{El m{\'{u}}sico y el docente}},
