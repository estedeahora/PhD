@book{Ziccardi2021,
abstract = {Ante la cr{\'{i}}tica situaci{\'{o}}n sanitaria y social que vive la sociedad mexicana como consecuencia de la pandemia global originada por el sars-cov2-covid-19, un grupo de acad{\'{e}}micas y acad{\'{e}}micos, al que se incorporaron estudiantes de posgrado, realiz{\'{o}} la investigaci{\'{o}}n colectiva que se publica en este libro con la intenci{\'{o}}n de resaltar la importancia que tienen las condiciones diferenciadas de habitabilidad y los bienes y servicios colectivos de nuestras ciudades para que la sociedad mexicana pueda enfrentar esta grave crisis. El principal criterio utilizado para la selecci{\'{o}}n de las ciudades estudiadas es su tama{\~{n}}o dado que la experiencia que se hab{\'{i}}a vivido a nivel global indicaba que la pandemia se concentraba en los grandes centros urbanos. Por ello se estudiaron las tres grandes regiones metropolitanas del sistema urbano nacional: Ciudad de M{\'{e}}xico, Guadalajara y Monterrey. Asimismo, se consider{\'{o}} importante estudiar las dos grandes ciudades fronterizas —Tijuana y Ciudad Ju{\'{a}}rez— dada la importancia que tienen las corrientes migratorias entre M{\'{e}}xico y EUA y su impacto en la expansi{\'{o}}n de la pandemia y se sumaron tres ciudades capitales —Cuernavaca, M{\'{e}}rida y Toluca— que concentran las principales actividades de gobierno y de servicios en sus respectivos estados. Para el an{\'{a}}lisis de estas ocho ciudades se crearon equipos de investigaci{\'{o}}n y se dise{\~{n}}{\'{o}} un cuestionario denominado “Condiciones de habitabilidad de las viviendas ante el 'distanciamiento social' impuesto por el covid-19” el cual fue aplicado en l{\'{i}}nea durante la Jornada Nacional de Sana Distancia. Tambi{\'{e}}n se analizaron las estad{\'{i}}sticas y datos censales disponibles sobre la situaci{\'{o}}n demogr{\'{a}}fica y socioecon{\'{o}}mica, las condiciones de pobreza urbana y desigualdad territorial, la incidencia del covid-19 y la capacidad hospitalaria local, as{\'{i}} como las acciones realizadas por los tres {\'{o}}rdenes de gobierno y las organizaciones sociales para contribuir a sobrellevar la grave situaci{\'{o}}n generada por esta emergencia sanitaria.},
editor = {Ziccardi, Alicia},
pages = {337},
publisher = {Cartas desde una pandemia, Correo Certificado, Coordinaci{\'{o}}n de Humanidades e Instituto de Investiga},
title = {{Habitabilidad, entorno urbano y distanciamiento social. Una investigaci{\'{o}}n en ocho ciudades mexicanas durante COVID -19}},
url = {http://ru.iis.sociales.unam.mx/handle/IIS/5922},
year = {2021}
}
