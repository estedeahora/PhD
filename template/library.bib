@article{Xiang2022,
abstract = {While access to school is one crucial aspect of education equality, there is a lack of research on factors that influence the distance that pupils travel to school. Previous studies have failed to reveal the relationship between pupils' socio-spatial characteristics and travel distance. This paper uncovers the multilevel structure, ignored hitherto, that underpins the determinants of pupils' travel distance. Using detailed travel survey data for Beijing and an appropriate multilevel modelling approach, this research reveals that contextual variation remains, having taken account of compositional (individual-level) variables; and that contextual factors, that is, school density and neighbourhood context, are more influential when compared with individual-level factors except for education stage and housing type. The policy implications include improved planning for schools in comparatively deprived areas, increased provision of affordable housing and enhanced education opportunities for migrant children.},
author = {Xiang, Lili and Gould, Myles and Stillwell, John},
doi = {10.1177/0042098021996227},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Xiang, Gould, Stillwell - 2022 - What determines pupils' travel distance to school in China A multilevel analysis of educational access.pdf:pdf},
issn = {0042-0980},
journal = {Urban Studies},
keywords = {DE: Geography of education,DE: Movilidad educativa,access,context effects,multilevel modelling,socio-spatial inequalities,travel distance},
mendeley-tags = {DE: Geography of education,DE: Movilidad educativa},
number = {5},
pages = {1048--1067},
title = {{What determines pupils' travel distance to school in China? A multilevel analysis of educational access in Beijing}},
url = {http://journals.sagepub.com/doi/10.1177/0042098021996227},
volume = {59},
year = {2022}
}
