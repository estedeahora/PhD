@article{James1985,
abstract = {How segregation should be measured within a social unit is controversial. It is argued here that the concept of segregation refers to distributional differences across subunits & that measures of segregation should be measures of dispersion rather than central tendency. Four basic principles of segregation measurement are proposed, & five specific measures of segregation are analyzed for consistency with the four principles. Only two measures (the Atkinson & the Gini Indexes) satisfy all four principles. These two measures tend to rank the levels of segregation in different units similarly, yet they sometimes disagree. Variation in segregation ranks is more pronounced for the remaining three measures, as is demonstrated empirically for a set of US public school districts in 1976. If Lorenz curves for two different districts cross, disagreement among segregation measures is more pronounced. Thus, choice of segregation measures can affect conclusions derived from empirical analyses of segregation. 1 Table, 4 Figures, 24 References. AA},
author = {James, David R. and Taeuber, Karl E.},
doi = {10.2307/270845},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/James, Taeuber - 1985 - Measures of Segregation.pdf:pdf},
issn = {00811750},
journal = {Sociological Methodology},
keywords = {AE: Medida de segregaci{\'{o}}n,DE: Segregaci{\'{o}}n educativa},
mendeley-tags = {AE: Medida de segregaci{\'{o}}n,DE: Segregaci{\'{o}}n educativa},
number = {1},
pages = {1--32},
title = {{Measures of Segregation}},
volume = {15},
year = {1985}
}
