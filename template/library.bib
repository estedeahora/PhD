file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Jones et al. - 2015 - Ethnic Residential Segregation A Multilevel, Multigroup, Multiscale Approach Exemplified by London in 2011.pdf:pdf},
issn = {0070-3370},
journal = {Demography},
keywords = {AE: Medida de segregaci{\'{o}}n,Ethnicity,London,Multilevel modeling,Multiple scales,Segregation},
mendeley-tags = {AE: Medida de segregaci{\'{o}}n},
