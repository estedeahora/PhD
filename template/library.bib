@article{Courgeau1999,
abstract = {En este art{\'{i}}culo se presentan tres enfoques para analizar datos biogr{\'{a}}ficos. El enfoque no param{\'{e}}trico permite tratar las interacciones de varios fen{\'{o}}menos demogr{\'{a}}ficos y conduce a diversos tipos de dependencia entre ellos. El enfoque param{\'{e}}trico busca introducir en el an{\'{a}}lisis la heterogeneidad observada en el seno de la poblaci{\'{o}}n, relacionando los comportamientos temporales con diversas caracter{\'{i}}sticas dependientes o independientes del tiempo. En enfoque semiparam{\'{e}}trico hace posible un tratamiento simult{\'{a}}neo de las interacciones y de la heterogeneidad. La cuesti{\'{o}}n de la heterogeneidad no observada en los datos se aborda tambi{\'{e}}n. Estos diversos m{\'{e}}todos se ilustran por medio de ejemplos de aplicaci{\'{o}}n con datos provenientes de encuestas.},
