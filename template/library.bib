@article{DiVirgilio2022a,
abstract = {La inserci{\'{o}}n en la ciudad de los grupos de menores ingresos se estructura en relaci{\'{o}}n con las intervenciones estatales, que se articulan definiendo una arquitectura del bienestar. A trav{\'{e}}s de la provisi{\'{o}}n de infraestructuras, servicios y equipamientos, el Estado se constituye en un motor de estratificaci{\'{o}}n y diferenciaci{\'{o}}n socio-territorial. El trabajo indaga c{\'{o}}mo el acceso a los recursos urbanos, en general, y a las infraestructuras, servicios y equipamientos, en particular, impactan en la producci{\'{o}}n de desigualdades socioespaciales en Buenos Aires. A partir de diferentes fuentes de datos p{\'{u}}blicas sobre infraestructuras y servicios se realiza un an{\'{a}}lisis cuantitativo que integra diferentes t{\'{e}}cnicas estad{\'{i}}sticas. Asimismo, recurre a entrevistas con informantes clave que permiten comprender mejor c{\'{o}}mo operan los recursos p{\'{u}}blicos en el acceso al bienestar y cu{\'{a}}l es el papel de las redes sociales de base territorial en ese contexto.},
author = {{Di Virgilio}, Mar{\'{i}}a Mercedes and Serrati, Pablo Santiago},
journal = {Revista Espa{\~{n}}ola de Sociolog{\'{i}}a},
keywords = {Acceso al bienestar,Arquitectura del bienestar,Ciudad de Buenos Aires,Desigualdades urbanas,US: AMGBA,US: Desigualdades urbanas,US: Infraestructura urbana,US: Pol{\'{i}}ticas p{\'{u}}blicas},
mendeley-tags = {US: AMGBA,US: Desigualdades urbanas,US: Infraestructura urbana,US: Pol{\'{i}}ticas p{\'{u}}blicas},
number = {Press},
title = {{Arquitectura del bienestar en la Ciudad Aut{\'{o}}noma de Buenos Aires}},
year = {2022}
}
@article{Lin2016,
abstract = {In decision making, preference orderings are orderings of a set of items according to the preferences (of judges). Such orderings arise in a variety of domains, including group decision making and support systems, consumer marketing, voting and recommendation systems. Measuring the consensus and extracting the consensus patterns in a set of pref- erence orderings are key to these areas. In this paper we deal with the representation of sets of preference orderings, the quantification of the degree to which judges agree on their ordering of the items (i.e. the concordance), and the efficient, meaningful description of such sets. We propose to represent the orderings in a subsequence-based feature space and present a new algorithm to calculate the size of the set of all common subsequences - the basis of a quantification of concordance, not only for pairs of orderings but also for sets of orderings. The new algorithm is fast and storage efficient with a time complexity of only O(Nn2) for the orderings of n items by N judges and a space complexity of only O(min{Nn, n2}). Also, we propose to represent the set of all N orderings through a smallest set of covering preferences and present an algorithm to construct this smallest covering set.},
archivePrefix = {arXiv},
arxivId = {arXiv:1609.04722v2},
author = {Lin, Zhiwei and Wang, Hui and Elzinga, Cees H.},
eprint = {arXiv:1609.04722v2},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Lin, Wang, Elzinga - 2016 - Concordance and the Smallest Covering Set of Preference Orderings.pdf:pdf},
keywords = {Concordance,_Impreso,all com- mon subsequences,feature space,kernel function,preference orderings,the smallest covering set},
mendeley-tags = {_Impreso},
pages = {1--20},
title = {{Concordance and the Smallest Covering Set of Preference Orderings}},
year = {2016}
}
