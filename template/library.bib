journal = {Habitat International},
keywords = {Cluster analysis,Latin American cities,Neighborhood classification,Socioeconomic segregation,US: Segregaci{\'{o}}n urbana,US: Tipolog{\'{i}}a de h{\'{a}}bitat,Urban infrastructure},
