booktitle = {La dimensi{\'{o}}n urbana de las desigualdades. Una mirada desde Am{\'{e}}rica Latina},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/R{\'{a}}mirez - 2018 - Los Loteos Populares en el Gran Buenos Aires un an{\'{a}}lisis de su conformaci{\'{o}}n y cambios sociodemogr{\'{a}}ficos recientes (1991.pdf:pdf},
keywords = {H{\'{a}}bitat popular,Loteos populares,Periferia metropolitana,Quilmes,Suelo urbano,Transformaciones territoriales,US: Crecimiento AMGBA,{\'{A}}rea Metropolitana de Buenos Aires},
mendeley-tags = {US: Crecimiento AMGBA},
title = {{Los Loteos Populares en el Gran Buenos Aires: un an{\'{a}}lisis de su conformaci{\'{o}}n y cambios sociodemogr{\'{a}}ficos recientes (1991-2010) en el municipio de Quilmes}},
