file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Di Virgilio - 2011 - La movilidad residencial una preocupaci{\'{o}}n sociol{\'{o}}gica.pdf:pdf},
issn = {2215-7484},
journal = {Territorios},
keywords = {US: Movilidad residencial,movilidad residencial,necesidades habitacionales,trayectorias residenciales},
mendeley-tags = {US: Movilidad residencial},
pages = {173--190},
title = {{La movilidad residencial: una preocupaci{\'{o}}n sociol{\'{o}}gica}},
url = {https://revistas.urosario.edu.co/index.php/territorios/article/view/1851},
volume = {25},
