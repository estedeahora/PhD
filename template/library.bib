journal = {Revista Latinoamericana de Metodolog{\'{i}}a de la Investigaci{\'{o}}n Social},
keywords = {Villas,asentamientos,estrategia metodol{\'{o}}gica,transformaciones territoriales},
number = {3},
title = {{Accidentes, decisiones y sorpresas: Un relato acerca de c{\'{o}}mo es posible abordar las transformaciones de urbanizaciones populares en el {\'{A}}rea Metropolitana de Buenos Aires}},
