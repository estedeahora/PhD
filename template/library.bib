@article{Bartholo2020,
abstract = {O artigo descreve padr{\~{o}}es de segrega{\c{c}}{\~{a}}o escolar no in{\'{i}}cio do processo formal de escolariza{\c{c}}{\~{a}}o na cidade do Rio de Janeiro, Brasil, e estima o efeito da segrega{\c{c}}{\~{a}}o escolar (efeito par ou efeito mistura/compositional effect) no aprendizado das crian{\c{c}}as nos dois primeiros anos na escola. Este {\'{e}} um fen{\^{o}}meno importante para analisar o processo de distribui{\c{c}}{\~{a}}o de oportunidades educacionais nas redes p{\'{u}}blicas e privadas de ensino. O conceito de segrega{\c{c}}{\~{a}}o escolar utilizado neste artigo se refere {\`{a}} distribui{\c{c}}{\~{a}}o desigual de alunos que partilham de uma caracter{\'{i}}stica espec{\'{i}}fica em um agrupamento de escolas. O estudo utiliza o {\'{I}}ndice de Segrega{\c{c}}{\~{a}}o (Segregation Index) e considera duas caracter{\'{i}}sticas dos alunos: 1) cor/ra{\c{c}}a; 2) escolaridade dos pais. O efeito da composi{\c{c}}{\~{a}}o social foi estimado com dados de um estudo longitudinal e analisa separadamente o aprendizado no primeiro e segundo ano na escola. Os resultados preliminares sugerem que os padr{\~{o}}es de segrega{\c{c}}{\~{a}}o escolar observados na pr{\'{e}}-escola s{\~{a}}o semelhantes aos descritos no primeiro ano do ensino fundamental. N{\~{a}}o h{\'{a}}, portanto, grande impacto nos padr{\~{o}}es de segrega{\c{c}}{\~{a}}o na transi{\c{c}}{\~{a}}o entre as etapas de ensino. Os modelos para estimar o efeito da composi{\c{c}}{\~{a}}o social das escolas (compositional effect) no aprendizado dos alunos sugerem que h{\'{a}} efeito, com resultados mais consistentes para a medida de linguagem.},
author = {Bartholo, Tiago Lisboa and Koslinski, Mariane Campelo and de Andrade, Felipe Macedo and {De Castro}, Daniel Lopes},
doi = {10.15366/reice2020.18.4.003},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Bartholo et al. - 2020 - Segrega{\c{c}}{\~{a}}o Escolar e Desigualdades Educacionais no In{\'{i}}cio da Escolariza{\c{c}}{\~{a}}o no Brasil.pdf:pdf;:C\:/Users/este.de.ahora/Documents/Biblioteca/Bartholo et al. - 2020 - Segrega{\c{c}}{\~{a}}o Escolar e Desigualdades Educacionais no In{\'{i}}cio da Escolariza{\c{c}}{\~{a}}o no Brasil(2).pdf:pdf},
