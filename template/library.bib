@article{Reardon2004,
abstract = {The measurement of residential segregation patterns and trends has been limited by a reliance on segregation measures that do not appropriately take into account the spatial patterning of population distributions. In this paper we define a general approach to measuring spatial segregation among multiple population groups. This general approach allows researchers to specify any theoretically based definition of spatial proximity desired in computing segregation measures. Based on this general approach, we develop a general spatial exposure/isolation index (P̃*), and a set of general multigroup spatial evenness/clustering indices: a spatial information theory index (H̃), a spatial relative diversity index (R̃), and a spatial dissimilarity index (D̃). We review these and previously proposed spatial segregation indices against a set of eight desirable properties of spatial segregation indices. We conclude that the spatial exposure I isolation index P̃* - which can be interpreted as a measure of the average composition of individuals' local spatial environments - and the spatial information theory index H̃ - which can be interpreted as a measure of the variation in the diversity of the local spatial environments of each individual - are the most conceptually and mathematically satisfactory of the proposed spatial indices.},
author = {Reardon, Sean F. and O'Sullivan, David},
doi = {10.1111/j.0081-1750.2004.00150.x},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Reardon, O'Sullivan - 2004 - Measures of spatial segregation.pdf:pdf},
issn = {00811750},
journal = {Sociological Methodology},
keywords = {AE: Medida de segregaci{\'{o}}n,US: Segregaci{\'{o}}n urbana},
mendeley-tags = {AE: Medida de segregaci{\'{o}}n,US: Segregaci{\'{o}}n urbana},
number = {650},
pages = {121--162},
title = {{Measures of spatial segregation}},
volume = {34},
year = {2004}
}
