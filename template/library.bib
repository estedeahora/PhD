file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Alegre, Benito, Gonz{\`{a}}lez - 2008 - Procesos de segregaci{\'{o}}n y polarizaci{\'{o}}n escolar la incidencia de las pol{\'{i}}ticas de zonificaci{\'{o}}n escolar.pdf:pdf},
