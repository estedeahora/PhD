@article{EscolanoUtrilla2007,
abstract = {La segregaci{\'{o}}n socioespacial es un fen{\'{o}}meno que se manifiesta a trav{\'{e}}s de m{\'{u}}ltiples dimensiones y a diversas escalas. Sin embargo, los {\'{i}}ndices habituales que se utilizan para medirla s{\'{o}}lo dan cuenta de una escala y est{\'{a}}n afectados por el tama{\~{n}}o y la forma de las unidades espaciales de an{\'{a}}lisis. Por otra parte, muchos de estos {\'{i}}ndices tampoco retienen la estructura de las configuraciones espaciales que la segregaci{\'{o}}n adquiere, a pesar de que {\'{e}}stas ejercen una influencia trascendental en el grado y efectos de la segregaci{\'{o}}n. La lagunaridad es una medida anal{\'{i}}tica multiescala de la heterogeneidad de una textura espacial. La propiedad multiescala y la capacidad para retener los patrones espaciales la convierten en una t{\'{e}}cnica alternativa {\'{u}}til para trazar la trayectoria temporal y espacial de la segregaci{\'{o}}n, y relacionar sus valores con otros procesos sociales, econ{\'{o}}micos, culturales y espaciales. En este art{\'{i}}culo se explora la influencia que los cambios del tama{\~{n}}o y forma de las unidades espaciales de an{\'{a}}lisis pueden tener en los {\'{i}}ndices de lagunaridad. Los resultados muestran que la lagunaridad es una medida consistente que refleja la variedad de patrones espaciales a todas las escalas, incluso aunque cambien las unidades espaciales de an{\'{a}}lisis. Palabras clave: Lagunaridad, segregaci{\'{o}}n socioespacial, multiescala, problema de la unidad espacial modificable, Santiago de Chile.},
author = {{Escolano Utrilla}, Severino},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Escolano Utrilla - 2007 - La medida de la segregaci{\'{o}}n residencial urbana an{\'{a}}lisis multiescala mediante {\'{i}}ndices de lagunaridad.pdf:pdf},
issn = {1578-5157},
journal = {Geofocus: Revista Internacional de Ciencia y Tecnolog{\'{i}}a de la Informaci{\'{o}}n Geogr{\'{a}}fica},
keywords = {US: Segregaci{\'{o}}n urbana,espacial modificable,lagunaridad,multiescala,problema de la unidad,santiago de chile,segregaci{\'{o}}n socioespacial},
mendeley-tags = {US: Segregaci{\'{o}}n urbana},
number = {7},
pages = {216--234},
title = {{La medida de la segregaci{\'{o}}n residencial urbana: an{\'{a}}lisis multiescala mediante {\'{i}}ndices de lagunaridad}},
year = {2007}
}
