keywords = {DE: Educaci{\'{o}}n privada,DE: MMI,DE: Movilidad social educativa,DE: Segmentaci{\'{o}}n educativa,desigualdad de oportunidades,desventajas acumuladas,logro educativo,segmentaci{\'{o}}n educativa},
