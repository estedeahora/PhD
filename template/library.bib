@article{Gabadinho2016,
abstract = {This article presents the PST R package for categorical sequence analysis with prob- abilistic suffix trees (PSTs), i.e., structures that store variable-length Markov chains (VLMCs). VLMCs allow to model high-order dependencies in categorical sequences with parsimonious models based on simple estimation procedures. The package is specifically adapted to the field of social sciences, as it allows for VLMC models to be learned from sets of individual sequences possibly containing missing values; in addition, the package is extended to account for case weights. This article describes how a VLMC model is learned from one or more categorical sequences and stored in a PST. The PST can then be used for sequence prediction, i.e., to assign a probability to whole observed or artificial sequences. This feature supports data mining applications such as the extraction of typi- cal patterns and outliers. This article also introduces original visualization tools for both the model and the outcomes of sequence prediction. Other features such as functions for pattern mining and artificial sequence generation are described as well. The PST package also allows for the computation of probabilistic divergence between two models and the fitting of segmented VLMCs, where sub-models fitted to distinct strata of the learning sample are stored in a single PST.},
author = {Gabadinho, Alexis and Ritschard, Gilbert},
doi = {10.18637/jss.v072.i03},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Gabadinho, Ritschard - 2016 - Analyzing State Sequences with Probabilistic Suffix Trees The PST R Package.pdf:pdf},
journal = {Journal of Statistical Software},
keywords = {R,SA: Markov,_Impreso,categorical sequences,probabilistic suffix trees,r,sequence data mining,sequence visualization,state sequences,variable-length markov chains},
mendeley-tags = {R,SA: Markov,_Impreso},
number = {3},
pages = {1--39},
title = {{Analyzing State Sequences with Probabilistic Suffix Trees: The PST R Package}},
volume = {72},
year = {2016}
}
@article{Slater2013,
abstract = {En este art{\'{i}}culo se avanza una cr{\'{i}}tica del estudio del efecto barrio en los estudios urbanos por el argumento de que la aceptaci{\'{o}}n de la ' donde te afecta en directo sus oportunidades de vida ' tesis , por muy bien intencionado, se pierde la cuesti{\'{o}}n estructural clave de por qu{\'{e}} la gente vive en lugares donde lo hacen en las ciudades. Mediante el examen de los factores estructurales que dan lugar a diferencias en la vida oportunidades y las desigualdades que producen, y por inversi{\'{o}}n de los efectos de vecindad tesis : sus oportunidades de vida afectan a donde usted vive , el problema se convierte en uno de entender las oportunidades de vida a trav{\'{e}}s de una teor{\'{i}}a de la acumulaci{\'{o}}n de capital y la lucha de clases en ciudades. Tal teor{\'{i}}a proporciona una comprensi{\'{o}}n de las injusticias inherentes a dejar que el mercado ( apuntalada por el Estado) sea la fuerza que determina el costo de la vivienda y siendo por tanto el principal determinante de donde vive la gente . El art{\'{i}}culo se basa en marxista teor{\'{i}}a urbana para afirmar que los programas de movilidad residencial abogaron por Efectos vecinales proponentes destacan en un terreno inestable , ya que si bien es cierto que ' los efectos de vecindad exceden lo que se predijo por la pobreza por s{\'{i}} sola , moviendo el pobres a un lugar m{\'{a}}s rico ser{\'{i}}a s{\'{o}}lo eliminar esa diferencia gradual, sin hacer frente a los arreglos institucionales capitalistas que crean la pobreza.},
author = {Slater, Tom},
doi = {10.1111/j.1468-2427.2013.01215.x},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Slater - 2013 - Your Life Chances Affect Where You Live A Critique of the 'Cottage Industry' of Neighbourhood Effects Research.pdf:pdf},
isbn = {1468-2427},
