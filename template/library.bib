@article{Meo2011,
abstract = {This article examines how students from the loser sections of the middle class dealt with the game of secondary schooling in a good state school in the city of Buenos Aires (Argentina). It engages with Bourdieus theory of social practice and, in particular, with its concepts of game, habitus and cultural capital. It argues that middle-class students embody a school habitus, which I call zafar. Zafar (a Spanish slang word) refers to students dispositions, practices and strategies towards social and educational demands of teachers and their school. Zafar propels middle-class students to be just good enough students, and promote an instrumental approach to schooling and learning. Although this paper offers an account within which the reproduction of relative educational advantage of a group of middle-class students takes place, it also poses questions about their future educational and occupational opportunities. {\textcopyright} 2011 Taylor & Francis.},
author = {Meo, Anal{\'{i}}a In{\'{e}}s},
doi = {10.1080/01425692.2011.559338},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Meo - 2011 - Zafar, so good Middle-class students, school habitus and secondary schooling in the city of Buenos Aires (Argentina).pdf:pdf},
issn = {01425692},
journal = {British Journal of Sociology of Education},
keywords = {Argentina,Bourdieu,DE: Desigualdad educativa,Habitus,Middle class,Secondary schooling},
mendeley-tags = {DE: Desigualdad educativa},
number = {3},
pages = {349--367},
title = {{Zafar, so good: Middle-class students, school habitus and secondary schooling in the city of Buenos Aires (Argentina)}},
volume = {32},
year = {2011}
}
@book{Sechet2008,
abstract = {Les textes r{\'{e}}unis dans cet ouvrage parlent tous d'espaces en partages et en transactions. Vivre dans un espace suppose de partager cet espace avec d'autres, d'y inscrire des capacit{\'{e}}s d'agir en faisant avec l'espace de chacun, en subissant les contraintes inh{\'{e}}rentes {\`{a}} la pr{\'{e}}sence des autres. Le partage peut aussi bien {\^{e}}tre la division que l'avoir en commun. Quant {\`{a}} la transaction, elle est op{\'{e}}ration commerciale aussi bien qu'accord, r{\'{e}}sultat de concessions et d'arrangements, de tractations, {\`{a}} moins qu'elle ne soit imposition d'autorit{\'{e}} comme peut l'{\^{e}}tre la transaction juridique. Le partage comme la transaction supposent r{\'{e}}ciprocit{\'{e}}. Ils sont action en ce sens o{\`{u}}, selon Hannah Arendt, l'action correspond {\`{a}} la condition humaine de la pluralit{\'{e}}. Ces textes ont {\'{e}}t{\'{e}} regroup{\'{e}}s en quatre parties th{\'{e}}matiques. La premi{\`{e}}re porte sur les mobilit{\'{e}}s r{\'{e}}sidentielles ou quotidiennes et permet de creuser la notion de capital spatial. La deuxi{\`{e}}me r{\'{e}}unit des textes qui traitent de la mobilisation de la ressource territoriale et de l'investissement des lieux par des individus ou des entreprises en mouvement. Avec la troisi{\`{e}}me, nous passons de la n{\'{e}}gociation au conflit territorial. Enfin, la quatri{\`{e}}me traite des marqueurs spatiaux, entre visibilit{\'{e}} mise en avant des {\'{e}}tudiants rennais, visibilit{\'{e}} occult{\'{e}}e des SDF {\`{a}} Bordeaux, visibilit{\'{e}} pour soi des pieds-noirs et visibilit{\'{e}} ni{\'{e}}e des descendants d'esclaves {\`{a}} Tananarive. Ce livre est l'un des trois ouvrages issus du colloque de Rennes, Espaces et soci{\'{e}}t{\'{e}}s aujourd'hui, tous publi{\'{e}}s dans la collection « G{\'{e}}ographie sociale » des PUR.},
address = {Rennes},
booktitle = {Espaces en transactions},
editor = {S{\'{e}}chet, Raymonde and Garat, Isabelle and Zeneidi, Djemila},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Unknown - 2008 - Espaces en transactions.pdf:pdf},
isbn = {9782753526792},
keywords = {US: Capital espacial},
mendeley-tags = {US: Capital espacial},
publisher = {Presses universitaires de Rennes},
title = {{Espaces en transactions}},
year = {2008}
}
