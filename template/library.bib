@article{Crowell2018,
abstract = {This study examines White-Latino residential segregation in six U.S. metropolitan areas using new methods to draw a connection between two dominant research traditions in the segregation literature and empirically analyze prevailing conceptual frameworks. Based on microlevel locational attainment analyses, we find that for Latinos, acculturation and socioeconomic status are positively associated with greater residential contact with Whites and thus promote lower segregation consistent with predictions of spatial assimilation theory. However, standardization and decomposition analysis reveals that a substantial portion of White-Latino segregation can be attributed to White-Latino differences in the ability to translate acculturation and socioeconomic assimilation into co-residence with Whites. Thus, consistent with predictions of place stratification theory, evidence suggests that spatial assimilation dynamics are limited by continuing race-based factors leading to the expectation that segregation will persist at moderate to high levels even after Latinos reach parity with Whites on social and economic resources that shape locational attainments. Therefore, we offer two conclusions. First, contemporary White-Latino segregation is due in part to group differences in social and economic resources that determine locational attainments and that this component of White-Latino segregation will continue to be significant so long as Whites and Latinos differ along these social and economic characteristics. Second, while spatial assimilation dynamics can promote partial reductions in White-Latino segregation, we expect segregation to continue at moderate to high levels because place stratification dynamics limit Latino residential integration even when Latinos and Whites are comparable on relevant resources.},
author = {Crowell, Amber R. and Fossett, Mark},
doi = {10.1177/2332649217748426},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Crowell, Fossett - 2018 - White and Latino Locational Attainments Assessing the Role of Race and Resources in U.S. Metropolitan Resident.pdf:pdf},
issn = {2332-6492},
journal = {Sociology of Race and Ethnicity},
keywords = {AE: Medida de segregaci{\'{o}}n,US: Segregaci{\'{o}}n urbana,latinos,place stratification,racial segregation,segregation,spatial assimilation},
mendeley-tags = {AE: Medida de segregaci{\'{o}}n,US: Segregaci{\'{o}}n urbana},
number = {4},
pages = {491--507},
title = {{White and Latino Locational Attainments: Assessing the Role of Race and Resources in U.S. Metropolitan Residential Segregation}},
volume = {4},
year = {2018}
}
@article{Duncan1955b,
abstract = {Several alternative indexes of the degree of residential segregation\nof the nonwhite pop of a city are contained in the literature. The\npresent paper summarizes the mathematical analysis made of several\nsuch indexes, and documents the conclusions reached. That there is\na lack of clarity and consistency in the specifications for a segregation\nindex and that several indexes utilize the {%} of nonwhites in the\ncity in their formulas. The fact that there is no meaningful criterion\nby which to judge whether {%} of nonwhites is a desirable property\nof segregation indexes suggests questioning the worth not meaningfulness\nof using such indexes to compare segregation in cities with greatly\ndifferent {%}s of nonwhites. Mathematical relationships among the\nvarious segregation indexes are first investigated formally (by showing\nthe relationships among the components of their formulas). The mathematical\nrelationships discovered seem to account for the empirical intercorrelations\nof index values obtained through use of different segregation indexes.\nMathematical relationships among the several indexes are further\ndetermined through use of a model segregation curve. The hyperbola\ncurve is described and formulas for the various indexes are computed\nfrom it. An hyperbola is fitted to census tract data for 60 cities\nand predicted values of each of the indexes are computed. It is discovered:\n(1) that there seems to be a characteristic form for the segregation\ncurves of large US cities despite variation in degree of segregation;\n{&}amp; (2) there is little information in any of the indexes beyond\nthat contained in the Nonwhite Section Index (Jahn, et al, Index\n{#}4) and the {%} of the city which is nonwhite. The other indexes\ncan be closely approximated given the Nonwhite Section Index, the\ncity nonwhite {%}, and the assumption of the hyperbolic form of\nsegregation curve. Choice of a segregation index is discussed in\nterms of empirical consequences of its use. It is emphasized and\nillustrated that results obtained with an index may be strongly affected\nby mathematical properties of the index. Inadequacies of segregation\nindex are discussed with particular attention to: (1) recognition\nof spatial pattern of segregation (cluster or pocket vs. belt etc.);\n(2) the study of the process of segregation, or change in segregation\npattern; {&}amp; (3) the problem of appropriate areal unit for segregation\nresearch (census tracts, blocks, etc.). Problems of validation of\nsegregation indexes are discussed. W. F. Kenkel.},
author = {Duncan, Otis Dudley and Duncan, Beverly},
doi = {10.2307/2088328},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Duncan, Duncan - 1955 - A Methodological Analysis of Segregation Indexes.pdf:pdf},
issn = {00031224},
journal = {American Sociological Review},
keywords = {AE: Medida de segregaci{\'{o}}n,US: Segregaci{\'{o}}n urbana},
mendeley-tags = {AE: Medida de segregaci{\'{o}}n,US: Segregaci{\'{o}}n urbana},
number = {2},
pages = {210--217},
title = {{A Methodological Analysis of Segregation Indexes}},
volume = {20},
year = {1955}
}
