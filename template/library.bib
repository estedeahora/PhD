@article{Dumay2008,
abstract = {Even if the literature on the effects of pupil composition has been extensive, no clear consensus has been reached concerning the significance and magnitude of this effect. The first objective of this article is to estimate the magnitude of the school composition effect in primary schools (6th grade) in French-speaking Belgium. Different indicators of school composition are used: academic, socio-cultural, 'language' and sex composition. Except for sex composition, the results show that the school composition effect explains significant amount of between schools variance even after controlling for pupils' initial performance, socio-cultural background, and non-cognitive dispositions. The second objective is to examine covariance between school composition and several organisational variables and their joint effect on school performance. The second set of analyses is intended to question the conceptual nature of the school composition effect, establishing whether it is direct or indirect. {\textcopyright} 2008 SES.},
author = {Dumay, Xavier and Dupriez, Vincent},
doi = {10.1111/j.1467-8527.2008.00418.x},
file = {:C\:/Users/este.de.ahora/Documents/Biblioteca/Dumay, Dupriez - 2008 - Does the school composition effect matter evidence from belgian data.pdf:pdf},
issn = {00071005},
journal = {British Journal of Educational Studies},
keywords = {DE: Efecto escuela,DE: Segmentaci{\'{o}}n educativa,DE: Segregaci{\'{o}}n educativa,Multi-level modelling,School composition effect,Segregation},
mendeley-tags = {DE: Efecto escuela,DE: Segmentaci{\'{o}}n educativa,DE: Segregaci{\'{o}}n educativa},
number = {4},
pages = {440--477},
title = {{Does the school composition effect matter? evidence from belgian data}},
volume = {56},
year = {2008}
}
